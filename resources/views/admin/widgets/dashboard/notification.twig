<div class="card">
  <div class="card-header">
    <h3 class="card-title">{{ trans('admin.notifications.send.title') }}</h3>
  </div>
  <form method="post" action="{{ url('/admin/notifications/send') }}">
    {{ csrf_field() }}
    <div class="card-body">
      {% if errors.any %}
        <div class="callout callout-danger">{{ errors.first }}</div>
      {% endif %}
      {% set sent_result = session_pull('sentResult') %}
      {% if sent_result %}
        <div class="callout callout-success">{{ sent_result }}</div>
      {% endif %}
      <div class="form-group">
        <label>{{ trans('admin.notifications.receiver.title') }}</label>
        <div class="radio">
        <label>
          <input type="radio" name="receiver" value="all" required>
          {{ trans('admin.notifications.receiver.all') }}
        </label>
        </div>
        <div class="radio">
          <label>
            <input type="radio" name="receiver" value="normal" required>
            {{ trans('admin.notifications.receiver.normal') }}
          </label>
        </div>
        <div class="radio">
          <label>
            <input type="radio" name="receiver" value="verified" required>
            {{ trans('admin.notifications.receiver.verified') }}
          </label>
        </div>
        <div class="radio">
          <label>
            <input type="radio" name="receiver" value="uid" required>
            {{ trans('admin.notifications.receiver.uid') }} &nbsp;
            <input type="number" name="uid" class="form-control">
          </label>
        </div>
        <div class="radio">
          <label>
            <input type="radio" name="receiver" value="email" required>
            {{ trans('admin.notifications.receiver.email') }} &nbsp;
            <input type="email" name="email" class="form-control">
          </label>
        </div>
      </div>
      <div class="form-group">
        <label>{{ trans('admin.notifications.title') }}</label>
        <input type="text" name="title" class="form-control" required maxlength="20">
      </div>
      <div class="form-group">
        <label>{{ trans('admin.notifications.content') }}</label>
        <textarea name="content" class="form-control" rows="3"></textarea>
      </div>
      <div class="form-group">
        <div class="custom-control custom-checkbox">
          <input type="checkbox" class="custom-control-input" id="notification-popup" name="popup_enabled" value="1">
          <label class="custom-control-label" for="notification-popup">{{ trans('admin.notifications.popup-enabled') }}</label>
        </div>
      </div>
      <div class="form-group" id="notification-publicity-option" hidden>
        <div class="custom-control custom-checkbox">
          <input type="checkbox" class="custom-control-input" id="notification-publicity" name="publicity_enabled" value="1" disabled>
          <label class="custom-control-label" for="notification-publicity">{{ trans('admin.notifications.sent.publicity') }}</label>
        </div>
      </div>
      <div class="form-group" id="notification-public-days-field" hidden>
        <label for="notification-public-days">{{ trans('admin.notifications.public-days') }}</label>
        <input type="number" id="notification-public-days" name="public_days" class="form-control" min="0" max="365" value="0" disabled>
        <small class="form-text text-muted">{{ trans('admin.notifications.sent.public-days-zero') }}</small>
      </div>
      <script>
        (function () {
          var popup = document.getElementById('notification-popup')
          var publicity = document.getElementById('notification-publicity')
          var option = document.getElementById('notification-publicity-option')
          var days = document.getElementById('notification-public-days')
          var daysField = document.getElementById('notification-public-days-field')
          function update() {
            option.hidden = !popup.checked
            publicity.disabled = !popup.checked
            if (!popup.checked) publicity.checked = false
            daysField.hidden = !popup.checked || !publicity.checked
            days.disabled = daysField.hidden
            if (days.disabled) days.value = '0'
          }
          popup.addEventListener('change', update)
          publicity.addEventListener('change', update)
          update()
        })()
      </script>
    </div>
    <div class="card-footer">
      <input
        type="submit"
        value="{{ trans('general.submit') }}"
        class="btn btn-primary"
      >
    </div>
  </form>
</div>

<div class="card mt-3" data-sent-notifications>
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title">{{ trans('admin.notifications.sent.title') }}</h3>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-sent-refresh>{{ trans('admin.notifications.sent.refresh') }}</button>
  </div>
  <div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>{{ trans('admin.notifications.title') }}</th><th>{{ trans('admin.notifications.sent.audience') }}</th><th>{{ trans('admin.notifications.sent.time') }}</th><th>{{ trans('admin.notifications.sent.status') }}</th><th></th></tr></thead><tbody data-sent-rows><tr><td colspan="5" class="text-center text-muted">{{ trans('admin.notifications.sent.loading') }}</td></tr></tbody></table></div></div>
  <div class="card-footer d-flex justify-content-between"><button type="button" class="btn btn-sm btn-link" data-sent-prev disabled>{{ trans('admin.notifications.sent.prev') }}</button><span data-sent-page>1</span><button type="button" class="btn btn-sm btn-link" data-sent-next disabled>{{ trans('admin.notifications.sent.next') }}</button></div>
</div>
<script>
(function () {
  var root = document.querySelector('[data-sent-notifications]'); if (!root) return
  var rows = root.querySelector('[data-sent-rows]'), pageLabel = root.querySelector('[data-sent-page]'), page = 1
  var csrf = document.querySelector('meta[name="csrf-token"]')
  function escapeHtml(value) { var el = document.createElement('span'); el.textContent = value == null ? '' : value; return el.innerHTML }
  function load(target) {
    fetch('{{ url('/admin/notifications') }}?page=' + target, { headers: { Accept: 'application/json' } }).then(function (response) { return response.json() }).then(function (result) {
      page = result.current_page || target; rows.innerHTML = ''
      ;(result.data || []).forEach(function (item) {
        var tr = document.createElement('tr'), revoked = item.status === 'revoked', publicized = item.is_publicity_active === true
        var sentAt = new Date(item.published_at || item.created_at).getTime(), mayRevoke = !revoked && Date.now() - sentAt < 24 * 60 * 60 * 1000
        var actions = ''
        if (publicized) actions += '<button class="btn btn-sm btn-outline-warning mr-1" data-end="' + escapeHtml(item.id) + '">{{ trans('admin.notifications.sent.end-publicity') }}</button>'
        if (mayRevoke) actions += '<button class="btn btn-sm btn-outline-danger" data-revoke="' + escapeHtml(item.id) + '">{{ trans('admin.notifications.sent.revoke') }}</button>'
        if (item.status === 'expired' && item.expires_at) actions += '<button class="btn btn-sm btn-outline-primary" data-reopen="' + escapeHtml(item.id) + '">{{ trans('admin.notifications.sent.reopen') }}</button>'
        tr.innerHTML = '<td>' + escapeHtml(item.title) + '</td><td>' + escapeHtml(item.audience) + '</td><td>' + escapeHtml(item.published_at || item.created_at) + '</td><td>' + escapeHtml(item.status) + '</td><td>' + actions + '</td>'
        rows.appendChild(tr)
      })
      if (!rows.children.length) rows.innerHTML = '<tr><td colspan="5" class="text-center text-muted">{{ trans('admin.notifications.sent.empty') }}</td></tr>'
      pageLabel.textContent = page; root.querySelector('[data-sent-prev]').disabled = page <= 1; root.querySelector('[data-sent-next]').disabled = page >= (result.last_page || page)
    })
  }
  rows.addEventListener('click', function (event) {
    var button = event.target.closest('[data-revoke],[data-end],[data-reopen]'); if (!button) return
    var action = button.dataset.revoke ? 'revoke' : (button.dataset.end ? 'end-publicity' : 'reopen'), id = button.dataset.revoke || button.dataset.end || button.dataset.reopen
    var message = action === 'revoke' ? '{{ trans('admin.notifications.sent.revoke-confirm') }}' : (action === 'end-publicity' ? '{{ trans('admin.notifications.sent.end-confirm') }}' : '{{ trans('admin.notifications.sent.reopen-confirm') }}')
    if (!window.confirm(message)) return
    fetch('{{ url('/admin/notifications') }}/' + id + '/' + action, { method: 'POST', headers: { 'X-CSRF-TOKEN': csrf ? csrf.content : '', Accept: 'application/json' } }).then(function (response) { if (response.ok) load(page) })
  })
  root.querySelector('[data-sent-prev]').addEventListener('click', function () { if (page > 1) load(page - 1) }); root.querySelector('[data-sent-next]').addEventListener('click', function () { load(page + 1) }); root.querySelector('[data-sent-refresh]').addEventListener('click', function () { load(page) }); load(page)
})()
</script>
